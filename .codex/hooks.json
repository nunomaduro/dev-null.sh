{
  "description": "Run composer test once per agent turn when source, config, or tests change.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash -lc 'ROOT=\"$(git rev-parse --show-toplevel)\"; \"$ROOT\"/.codex/hooks/track-file-edit.sh'",
            "timeout": 10,
            "statusMessage": "Tracking edited files for tests"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash -lc 'ROOT=\"$(git rev-parse --show-toplevel)\"; \"$ROOT\"/.codex/hooks/run-tests-on-stop.sh'",
            "timeout": 600,
            "statusMessage": "Running composer test if needed"
          }
        ]
      }
    ]
  }
}
